<article class="article article--page">
  <header class="article__head">
    <p class="eyebrow rise" style="--d:.1s">Jeffery Liu — <%= page.title %></p>
    <h1 class="article__title article__title--xl"><%- split_chars(page.title, 0.15, 0.05) %></h1>
    <div class="article__rule rise" style="--d:.6s"></div>
  </header>
  <div class="prose" data-prose>
    <%- page.content %>
  </div>
</article>
