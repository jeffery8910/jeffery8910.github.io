<!doctype html>
<html lang="zh-TW">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <% const pageTitle = page.title ? page.title + '｜' + config.title : config.title %>
  <title><%= pageTitle %></title>
  <meta name="description" content="<%= page.description || page.excerpt && strip_html(page.excerpt).slice(0, 120) || config.description %>">
  <meta property="og:title" content="<%= pageTitle %>">
  <meta property="og:description" content="<%= config.description %>">
  <meta name="theme-color" content="#0b0d14">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700;900&family=Syne:wght@500;700;800&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
  <link rel="stylesheet" href="<%- url_for('/css/style.css') %>">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%230b0d14'/%3E%3Ccircle cx='32' cy='32' r='14' fill='%23ffb86b'/%3E%3C/svg%3E">
  <script>
    document.documentElement.classList.add('js');
    // Safety net: never leave text hidden if the main script is slow or blocked.
    setTimeout(function () { document.documentElement.classList.add('is-ready'); }, 3000);
  </script>
</head>
<body class="<%= is_home() ? 'is-home' : '' %>">
  <% if (is_home() && !page.prev) { %>
  <div class="loader" data-loader>
    <div class="loader__top"><span>jeffery8910</span><span>Portfolio — 2026</span></div>
    <div class="loader__bar"><span data-loader-bar></span></div>
    <div class="loader__count" data-loader-count>000</div>
  </div>
  <% } %>

  <div class="curtain" data-curtain aria-hidden="true"><span><%= config.title %></span></div>

  <header class="nav">
    <a class="nav__brand" href="<%- url_for('/') %>">
      <strong>Jeffery Liu</strong><span>教學工程 × AI</span>
    </a>
    <nav class="nav__links">
      <% theme.menu.forEach(function (item) { %>
        <a class="nav__link" href="<%- url_for(item.path) %>"><span data-text="<%= item.name %>"><%= item.name %></span></a>
      <% }) %>
    </nav>
  </header>

  <main class="main">
    <%- body %>
  </main>

  <footer class="footer">
    <div class="footer__big" data-reveal>
      <p class="eyebrow">Let's talk</p>
      <a class="footer__cta" href="https://www.linkedin.com/in/jeffery8910" target="_blank" rel="noreferrer">
        <%- split_chars('一起聊聊教學與 AI', 0, 0.03) %> <span class="footer__arrow">↗</span>
      </a>
    </div>
    <div class="footer__row">
      <span>© <%= new Date().getFullYear() %> <%= config.author %></span>
      <span class="footer__links">
        <% theme.links.forEach(function (l) { %>
          <a href="<%- l.url %>" target="_blank" rel="noreferrer"><%= l.name %> ↗</a>
        <% }) %>
      </span>
    </div>
  </footer>

  <div class="cursor-ring" data-cursor><span data-cursor-label></span></div>
  <div class="cursor-dot" data-cursor-dot></div>
  <div class="grain" aria-hidden="true"></div>

  <script src="<%- url_for('/js/main.js') %>" defer></script>
</body>
</html>
