<% const h = theme.hero, v = theme.values, a = theme.audiences, m = theme.method, j = theme.journey, w = theme.writing %>
<% if (!page.prev) { %>
<section class="hero">
  <div class="hero__sun" aria-hidden="true"></div>
  <div class="hero__studio" aria-hidden="true"></div>
  <div class="hero__grid">
    <div class="hero__meta hero__meta--tl rise" style="--d:.15s"><span><%= h.eyebrow %></span></div>
    <div class="hero__meta hero__meta--tr rise" style="--d:.25s"><span><%= h.meta_left %></span><span><%= h.meta_right %></span></div>

    <h1 class="hero__title">
      <% h.lines.forEach(function (line, i) { %>
        <span class="hero__line"><%- split_chars(line, 0.3 + i * 0.22, 0.07) %></span>
      <% }) %>
      <span class="hero__outline"><%- split_chars(h.outline, 0.75, 0.025) %></span>
    </h1>

    <div class="hero__lead rise" style="--d:1s">
      <p><%= h.lead %></p>
      <div class="hero__actions">
        <a class="btn btn--solid" href="#method">看我怎麼工作 <span>↓</span></a>
        <a class="btn" href="<%= theme.studio_url %>" target="_blank" rel="noreferrer" data-cursor-text="進來坐">走進 3D 工作室 <span>↗</span></a>
      </div>
    </div>
  </div>
</section>

<div class="marquee" aria-hidden="true">
  <div class="marquee__track">
    <% for (let r = 0; r < 4; r++) { theme.marquee.forEach(function (word, i) { %>
      <span><%= word %></span><span class="marquee__dot"><%- motif_icon(['sun', 'drop', 'horizon'][i % 3]) %></span>
    <% }) } %>
  </div>
</div>

<section class="section values" id="values">
  <header class="section-head" data-reveal>
    <p class="eyebrow"><%= v.eyebrow %></p>
    <h2 class="section-title"><%- split_chars(v.title, 0, 0.06) %></h2>
    <p class="section-intro"><%= v.intro %></p>
  </header>
  <div class="values__grid">
    <% v.items.forEach(function (item, i) { %>
      <article class="value value--<%= item.icon %>" data-reveal style="--d:<%= i * 0.12 %>s">
        <div class="value__icon"><%- motif_icon(item.icon) %></div>
        <span class="value__key"><%= item.key %></span>
        <h3><%= item.title %></h3>
        <p><%= item.text %></p>
      </article>
    <% }) %>
  </div>
</section>

<section class="section audiences">
  <header class="section-head" data-reveal>
    <p class="eyebrow"><%= a.eyebrow %></p>
    <h2 class="section-title"><%- split_chars(a.title, 0, 0.04) %></h2>
  </header>
  <ol class="aud">
    <% a.items.forEach(function (item, i) { %>
      <li class="aud__row" data-reveal style="--d:<%= i * 0.08 %>s">
        <span class="aud__index"><%= pad2(i + 1) %></span>
        <div class="aud__who"><strong><%= item.who %></strong><span><%= item.need %></span></div>
        <p class="aud__offer"><%= item.offer %></p>
      </li>
    <% }) %>
  </ol>
  <a class="btn btn--solid" href="mailto:<%= theme.contact_email %>" data-reveal data-cursor-text="寫信"><%= a.cta %> <span>→</span></a>
</section>

<section class="section method" id="method">
  <header class="section-head" data-reveal>
    <p class="eyebrow"><%= m.eyebrow %></p>
    <h2 class="section-title"><%- split_chars(m.title, 0, 0.03) %></h2>
    <p class="section-intro"><%= m.intro %></p>
    <p class="scroll-hint">← 左右滑動，看完整張圖 →</p>
  </header>
  <%- partial('_partial/blueprint') %>
</section>

<section class="section journey-section">
  <header class="section-head" data-reveal>
    <p class="eyebrow"><%= j.eyebrow %></p>
    <h2 class="section-title"><%- split_chars(j.title, 0, 0.03) %></h2>
    <p class="section-intro"><%= j.intro %></p>
    <p class="scroll-hint">← 左右滑動，看完整張圖 →</p>
  </header>
  <%- partial('_partial/journey') %>
</section>
<% } %>

<section class="section index" id="writing">
  <header class="section-head" data-reveal>
    <p class="eyebrow"><%= w.eyebrow %></p>
    <h2 class="section-title"><%- split_chars(w.title, 0, 0.04) %></h2>
  </header>
  <%- partial('_partial/post-list', { posts: page.posts }) %>
  <% if (page.total > 1) { %>
    <nav class="pager" data-reveal>
      <% if (page.prev) { %><a class="btn" href="<%- url_for(page.prev_link) %>">← 較新</a><% } %>
      <span><%= page.current %> / <%= page.total %></span>
      <% if (page.next) { %><a class="btn" href="<%- url_for(page.next_link) %>">較舊 →</a><% } %>
    </nav>
  <% } %>
</section>

<section class="section statement" data-reveal>
  <%- motif_icon('drop') %>
  <p class="statement__text"><%= theme.statement %></p>
  <a class="link-arrow" href="<%- url_for('/about/') %>">多認識我一點 <span>→</span></a>
</section>
