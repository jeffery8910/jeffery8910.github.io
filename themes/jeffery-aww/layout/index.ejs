<% const h = theme.hero %>
<section class="hero">
  <div class="hero__orb" aria-hidden="true"></div>
  <div class="hero__grid">
    <div class="hero__meta hero__meta--tl rise" style="--d:.15s"><span><%= h.eyebrow %></span></div>
    <div class="hero__meta hero__meta--tr rise" style="--d:.25s"><span><%= h.meta_left %></span><span><%= h.meta_right %></span></div>

    <h1 class="hero__title">
      <% h.lines.forEach(function (line, i) { %>
        <span class="hero__line"><%- split_chars(line, 0.3 + i * 0.22, 0.07) %></span>
      <% }) %>
      <span class="hero__outline"><%- split_chars(h.outline, 0.75, 0.025) %></span>
    </h1>

    <p class="hero__tagline rise" style="--d:1s"><%= h.tagline %></p>

    <a class="badge rise" style="--d:1.1s" href="#index" aria-label="往下看文章">
      <svg viewBox="0 0 200 200" class="badge__ring" aria-hidden="true">
        <defs><path id="badge-circle" d="M100,100 m-78,0 a78,78 0 1,1 156,0 a78,78 0 1,1 -156,0"/></defs>
        <text><textPath href="#badge-circle" textLength="486" lengthAdjust="spacing">SCROLL TO EXPLORE • 往下看看 • SCROLL •</textPath></text>
      </svg>
      <span class="badge__core">↓</span>
    </a>
  </div>
</section>

<div class="marquee" aria-hidden="true">
  <div class="marquee__track">
    <% for (let r = 0; r < 4; r++) { theme.marquee.forEach(function (word) { %>
      <span><%= word %></span><span class="marquee__dot">✦</span>
    <% }) } %>
  </div>
</div>

<section class="index" id="index">
  <header class="section-head" data-reveal>
    <p class="eyebrow">(02) Selected writing</p>
    <h2 class="section-title"><%- split_chars('文章與作品筆記', 0, 0.04) %></h2>
  </header>
  <%- partial('_partial/post-list', { posts: page.posts }) %>
  <% if (page.total > 1) { %>
    <nav class="pager" data-reveal>
      <% if (page.prev) { %><a class="pill" href="<%- url_for(page.prev_link) %>">← 較新</a><% } %>
      <span><%= page.current %> / <%= page.total %></span>
      <% if (page.next) { %><a class="pill" href="<%- url_for(page.next_link) %>">較舊 →</a><% } %>
    </nav>
  <% } %>
</section>

<section class="statement" data-reveal>
  <p class="eyebrow">(03) About</p>
  <p class="statement__text">
    我在意的不是工具有多新，而是一個工具到了學生和老師手上，能不能真的一步一步用起來。
  </p>
  <a class="link-arrow" href="<%- url_for('/about/') %>">認識我 <span>→</span></a>
</section>
